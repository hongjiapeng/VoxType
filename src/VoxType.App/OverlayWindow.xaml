<Window x:Class="VoxType_App.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:VoxType_App" Title="VoxType 语音输入">
    <Border x:Name="Root" Background="{ThemeResource OverlaySurfaceBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="16,10">

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" FontSize="21" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OverlayStatus" />
                <StackPanel x:Name="Waveform" Orientation="Horizontal" Spacing="3" Height="20" Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsListening), Mode=OneWay}" AutomationProperties.Name="麦克风音量" />
                <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Badge, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsProcessing), Mode=OneWay}" AutomationProperties.Name="语音输入处理中" />
                <Button Content="结束并识别" FontSize="11" Padding="6,4" Command="{x:Bind ViewModel.StopCommand}" Visibility="{x:Bind local:MainPage.Visible(ViewModel.ShowStop), Mode=OneWay}" AllowFocusOnInteraction="False" IsTabStop="False" AutomationProperties.AutomationId="StopRecording" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
