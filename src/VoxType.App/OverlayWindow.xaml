<Window x:Class="VoxType_App.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:VoxType_App" Title="VoxType 语音输入">
    <UserControl x:Name="Root">
        <Grid Background="{ThemeResource OverlaySurfaceBrush}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SessionStates">
                    <VisualState x:Name="Listening" />
                    <VisualState x:Name="Processing">
                        <VisualState.Setters>
                            <Setter Target="StatusIcon.Background" Value="{ThemeResource OverlayProcessingSurfaceBrush}" />
                            <Setter Target="StatusIcon.BorderBrush" Value="{ThemeResource OverlayProcessingStrokeBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Completed">
                        <VisualState.Setters>
                            <Setter Target="StatusIcon.Background" Value="{ThemeResource OverlaySuccessSurfaceBrush}" />
                            <Setter Target="StatusIcon.BorderBrush" Value="{ThemeResource OverlaySuccessStrokeBrush}" />
                            <Setter Target="StatusGlyph.Foreground" Value="{ThemeResource OverlaySuccessBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Failed">
                        <VisualState.Setters>
                            <Setter Target="StatusIcon.Background" Value="{ThemeResource OverlayWarningSurfaceBrush}" />
                            <Setter Target="StatusIcon.BorderBrush" Value="{ThemeResource OverlayWarningStrokeBrush}" />
                            <Setter Target="StatusGlyph.Foreground" Value="{ThemeResource OverlayWarningBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border BorderBrush="{ThemeResource OverlayStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid x:Name="ContentPanel" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VoxType" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind ViewModel.BadgeGlyph, Mode=OneWay}" FontSize="10"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind ViewModel.Badge, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="结束" FontSize="11" MinHeight="32" Padding="10,3"
                                Command="{x:Bind ViewModel.StopCommand}"
                                Visibility="{x:Bind local:MainPage.Visible(ViewModel.ShowStop), Mode=OneWay}"
                                AllowFocusOnInteraction="False" IsTabStop="False"
                                AutomationProperties.Name="结束录音并识别" AutomationProperties.AutomationId="StopRecording" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="14" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="StatusIcon" Width="40" Height="40" CornerRadius="20" BorderThickness="1"
                                BorderBrush="{ThemeResource OverlayListeningStrokeBrush}"
                                Background="{ThemeResource OverlayListeningSurfaceBrush}" VerticalAlignment="Center">
                            <Grid>
                                <FontIcon x:Name="StatusGlyph" Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                                          Foreground="{ThemeResource OverlayListeningBrush}"
                                          Visibility="{x:Bind local:OverlayWindow.IconVisibility(ViewModel.IsProcessing), Mode=OneWay}"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <ProgressRing Width="20" Height="20" Foreground="{ThemeResource OverlayProcessingBrush}"
                                              IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"
                                              Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsProcessing), Mode=OneWay}"
                                              AutomationProperties.Name="语音输入处理中" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.AutomationId="OverlayStatus" />
                                <StackPanel Grid.Column="1" x:Name="Waveform" Orientation="Horizontal" Spacing="2" Height="22"
                                            VerticalAlignment="Center" AutomationProperties.Name="麦克风音量"
                                            Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsListening), Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" FontSize="12"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="OverlayDetail"
                                           AutomationProperties.LiveSetting="Polite"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.Detail, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                            Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsListening), Mode=OneWay}">
                                    <Border Background="{ThemeResource OverlayBadgeBrush}" BorderBrush="{ThemeResource OverlayStrokeBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="Esc" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="取消" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </UserControl>
</Window>
