<Window x:Class="VoxType_App.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:VoxType_App" Title="VoxType 语音输入">
    <UserControl x:Name="Root">
        <Grid Background="{ThemeResource OverlaySurfaceBrush}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SessionStates">
                    <VisualState x:Name="Listening" />
                    <VisualState x:Name="Processing" />
                    <VisualState x:Name="Completed">
                        <VisualState.Setters>
                            <Setter Target="StatusGlyph.Foreground" Value="{ThemeResource OverlaySuccessBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Failed">
                        <VisualState.Setters>
                            <Setter Target="StatusGlyph.Foreground" Value="{ThemeResource OverlayWarningBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Capsule" BorderBrush="{ThemeResource OverlayStrokeBrush}"
                    BorderThickness="1" CornerRadius="28" Padding="12,8">
              <Grid>
                <Grid x:Name="ContentPanel" ColumnSpacing="8" VerticalAlignment="Center"
                      Visibility="{x:Bind local:MainPage.Visible(ViewModel.ShowSession), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="SessionDragRegion" Grid.ColumnSpan="3" Background="Transparent"
                          Loaded="DragRegion_Loaded" ToolTipService.ToolTip="按住波形或文字拖动浮窗"
                          AutomationProperties.Name="拖动浮窗" AutomationProperties.AutomationId="OverlayDragRegion" />
                    <Border Background="Transparent" ToolTipService.ToolTip="按住波形或文字拖动浮窗">
                        <FontIcon Glyph="&#xE784;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Grid Grid.Column="1" Height="32" VerticalAlignment="Center">
                        <StackPanel x:Name="Waveform" Orientation="Horizontal" Spacing="3.5" Height="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    AutomationProperties.Name="麦克风音量"
                                    Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsListening), Mode=OneWay}" />
                        <FontIcon x:Name="StatusGlyph" Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                  Foreground="{ThemeResource OverlayListeningBrush}"
                                  Visibility="{x:Bind local:MainPage.Visible(ViewModel.ShowIcon), Mode=OneWay}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <ProgressRing Width="22" Height="22" Foreground="{ThemeResource OverlayProcessingBrush}"
                                      IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"
                                      Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsProcessing), Mode=OneWay}"
                                      AutomationProperties.Name="语音输入处理中" />
                    </Grid>
                    <StackPanel x:Name="TextPanel" Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind ViewModel.FullDetail, Mode=OneWay}">
                        <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OverlayStatus"
                                   AutomationProperties.HelpText="{x:Bind ViewModel.FullDetail, Mode=OneWay}" />
                        <TextBlock x:Name="DetailText" Text="{x:Bind ViewModel.Detail, Mode=OneWay}" FontSize="12"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind local:MainPage.Visible(ViewModel.ShowDetail), Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="OverlayDetail" AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.HelpText="{x:Bind ViewModel.FullDetail, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="结束" FontSize="12" MinHeight="32" MinWidth="44"
                            Padding="10,4" CornerRadius="16" VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.StopCommand}"
                            Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsListening), Mode=OneWay}"
                            AllowFocusOnInteraction="False" IsTabStop="False"
                            AutomationProperties.Name="结束录音并识别" AutomationProperties.AutomationId="StopRecording" />
                    <Button Grid.Column="3" Content="重试" Click="StartClicked" MinWidth="44" MinHeight="32" Padding="8,4" CornerRadius="16"
                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                            Visibility="{x:Bind local:MainPage.Visible(ViewModel.ShowRetry), Mode=OneWay}"
                            AllowFocusOnInteraction="False" IsTabStop="False"
                            AutomationProperties.Name="重新开始语音输入" AutomationProperties.AutomationId="RetryRecording" />
                    <Button Grid.Column="4" Click="MoreClicked" MinWidth="28" Width="28" MinHeight="32" Padding="0" Background="Transparent" BorderThickness="0"
                            AllowFocusOnInteraction="False" IsTabStop="False" ToolTipService.ToolTip="更多"
                            AutomationProperties.Name="更多浮窗选项" AutomationProperties.AutomationId="OverlayMore">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                </Grid>
                <Grid ColumnSpacing="4" Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsStandby), Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="36" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                    <Border x:Name="IdleDragRegion" Background="Transparent" Loaded="DragRegion_Loaded"
                            ToolTipService.ToolTip="按住这里拖动浮窗" AutomationProperties.Name="拖动浮窗" AutomationProperties.AutomationId="OverlayIdleDragRegion">
                        <FontIcon Glyph="&#xE784;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Button Grid.Column="1" Click="StartClicked" Width="36" MinWidth="36" Height="36" Padding="0" CornerRadius="18"
                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" AllowFocusOnInteraction="False" IsTabStop="False"
                            ToolTipService.ToolTip="开始语音输入 · 麦克风未开启"
                            AutomationProperties.Name="开始语音输入，麦克风未开启" AutomationProperties.AutomationId="StartRecording">
                        <FontIcon Glyph="&#xE720;" FontSize="20" />
                    </Button>
                    <Button Grid.Column="2" Click="MoreClicked" MinWidth="28" Width="28" MinHeight="32" Padding="0" Background="Transparent" BorderThickness="0"
                            AllowFocusOnInteraction="False" IsTabStop="False" ToolTipService.ToolTip="更多"
                            AutomationProperties.Name="更多浮窗选项" AutomationProperties.AutomationId="OverlayMoreIdle">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                </Grid>
              </Grid>
            </Border>
        </Grid>
    </UserControl>
</Window>
