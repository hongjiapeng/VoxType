<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Compile Include="../../src/VoxType.App/ViewModels/ModelManagerViewModel.cs" Link="ViewModels/ModelManagerViewModel.cs" />
    <Compile Include="../../src/VoxType.App/ViewModels/MainPageViewModel.cs" Link="ViewModels/MainPageViewModel.cs" />
    <Compile Include="../../src/VoxType.App/ViewModels/OverlayViewModel.cs" Link="ViewModels/OverlayViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\services\R2T2.Server\R2T2.Server.csproj" />
    <ProjectReference Include="..\..\src\VoxType.Core\VoxType.Core.csproj" />
    <ProjectReference Include="..\..\src\VoxType.Infrastructure\VoxType.Infrastructure.csproj" />
    <ProjectReference Include="..\VoxType.R2T2.TestHost\VoxType.R2T2.TestHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyR2T2TestHost" AfterTargets="Build">
    <MSBuild Projects="../VoxType.R2T2.TestHost/VoxType.R2T2.TestHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="R2T2TestHostAssembly" />
    </MSBuild>
    <PropertyGroup>
      <R2T2TestHostDirectory>@(R2T2TestHostAssembly->'%(RootDir)%(Directory)')</R2T2TestHostDirectory>
    </PropertyGroup>
    <ItemGroup>
      <R2T2TestHostFiles Include="$(R2T2TestHostDirectory)llama-server.*" />
    </ItemGroup>
    <Copy SourceFiles="@(R2T2TestHostFiles)" DestinationFolder="$(OutDir)r2t2-testhost" />
  </Target>

</Project>
